{
  "name": "noether-extension-starter",
  "version": "1.1.0",
  "description": "Official starter template for building community extensions for Noether",
  "main": "dist/main.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",

    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "noether": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  }
}
